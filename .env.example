# Copy to .env before `docker compose up`.
POSTGRES_USER=authapi
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=authapi

# HS256 signing key — MUST be >= 32 characters (256 bits). Generate your own for production.
JWT_KEY=dev_only_change_me_0123456789_abcdefghijklmnop
JWT_ISSUER=auth-api
JWT_AUDIENCE=auth-api-clients

# Host ports (DB_PORT off 5432 to avoid clashing with a local PostgreSQL)
API_PORT=8082
DB_PORT=15432
